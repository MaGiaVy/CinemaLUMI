# ==========================================
# 1. DATABASE (PostgreSQL - Prisma)
# ==========================================
# Cú pháp: postgresql://<user>:<password>@<host>:<port>/<database_name>?schema=public
DATABASE_URL="postgresql://postgres.izoldmbxuvtuhmvvcnlw:M%40giavy2652006@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.izoldmbxuvtuhmvvcnlw:M%40giavy2652006@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ==========================================
# 2. NEXTAUTH (Xác thực & Bảo mật)
# ==========================================
# URL ứng dụng khi chạy local
NEXTAUTH_URL="http://localhost:3000"

# Chuỗi bí mật để mã hóa JWT/Session (tạo ngẫu nhiên bằng lệnh: openssl rand -base64 32)
NEXTAUTH_SECRET="your_nextauth_secret_key_here_super_secret_123"

# ==========================================
# 3. CLOUDINARY (Upload Poster phim, Avatar)
# ==========================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ==========================================
# 4. SMTP / EMAIL (Nodemailer gửi mã vé / OTP)
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
# Mật khẩu ứng dụng (App Password) của Gmail, không dùng mật khẩu Gmail thông thường
SMTP_PASSWORD="your_gmail_app_password"
EMAIL_FROM="LUMI CINEMA <no-reply@lumicinema.vn>"