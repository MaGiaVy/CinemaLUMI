@startuml
title Activity — Quản lý combo

' Nguồn: https://docs.google.com/document/d/1Bo2MbuEJUP8o421n0obrvHAogGqLLJeWQNq8HZ_7780/edit
' Tiền điều kiện: Admin có quyền quản lý combo. Các nhánh lựa chọn ứng với các chức năng trong đặc tả.
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 14
skinparam shadowing false
skinparam monochrome true
skinparam conditionStyle InsideDiamond
skinparam backgroundColor white
skinparam ArrowColor black
skinparam activity {
  BackgroundColor white
  BorderColor black
  FontColor black
  DiamondBackgroundColor white
  DiamondBorderColor black
  DiamondFontColor black
  StartColor black
  EndColor black
}

|Admin|
start
:Chọn quản lý combo;
|Hệ thống|
:Hiển thị danh sách combo;
|Admin|
:Chọn thêm, sửa, ngừng bán\nhoặc cập nhật tồn kho;
if (Thêm mới?) then (Không)
  :Chọn combo cần xử lý;
  |Hệ thống|
  :Tìm thông tin combo;
  if (Combo\ntồn tại?) then (Có)
    :Hiển thị thông tin hiện tại;
  else (Không)
    :Thông báo không tìm thấy combo;
    stop
  endif
else (Có)
endif
|Admin|
if (Chọn\nngừng bán?) then (Có)
  |Hệ thống|
  if (Đã\nngừng bán?) then (Có)
    :Thông báo combo đã ngừng bán;
    stop
  else (Không)
  endif
else (Không)
endif
|Hệ thống|
:Hiển thị biểu mẫu hoặc yêu cầu xác nhận\ntheo thao tác đã chọn;
|Admin|
:Nhập thông tin combo / tồn kho nếu cần,
xem lại thông tin cần thay đổi;
if (Xác nhận\nthao tác?) then (Có)
else (Không)
  :Hủy thao tác;
  stop
endif

|Hệ thống|
:Kiểm tra thông tin combo / số lượng tồn kho;
while (Dữ liệu\nhợp lệ?) is (Không)
  :Thông báo lỗi và yêu cầu nhập lại;
  |Admin|
  :Điều chỉnh thông tin combo / số lượng tồn kho;
  :Xác nhận thông tin;
  |Hệ thống|
  :Kiểm tra lại thông tin combo / số lượng tồn kho;
endwhile (Có)

:Lưu mới / sửa thông tin / ngừng bán\nhoặc cập nhật tồn kho\ntheo thao tác đã chọn;

|Hệ thống|
if (Lưu thay đổi\nthành công?) then (Có)
  :Thông báo thành công;
  :Cập nhật danh sách combo;
else (Không)
  :Thông báo thao tác thất bại;
endif
stop
@enduml
