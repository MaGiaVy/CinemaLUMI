@startuml
title Activity — Quản lý voucher

' Nguồn: https://docs.google.com/document/d/1Bo2MbuEJUP8o421n0obrvHAogGqLLJeWQNq8HZ_7780/edit
' Tiền điều kiện: Admin có quyền quản lý voucher. Các nhánh lựa chọn ứng với các chức năng trong đặc tả.
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 14
skinparam shadowing false
skinparam monochrome true
skinparam conditionStyle InsideDiamond
skinparam backgroundColor white
skinparam ArrowColor black
skinparam activity {
  BackgroundColor white
  BorderColor black
  FontColor black
  DiamondBackgroundColor white
  DiamondBorderColor black
  DiamondFontColor black
  StartColor black
  EndColor black
}

|Admin|
start
:Chọn quản lý voucher;
|Hệ thống|
:Hiển thị danh sách voucher;
|Admin|
:Chọn thêm, sửa, ngừng sử dụng;
if (Thêm mới?) then (Không)
  :Chọn voucher cần xử lý;
  |Hệ thống|
  :Tìm thông tin voucher;
  if (Voucher\ntồn tại?) then (Có)
    :Hiển thị thông tin hiện tại;
  else (Không)
    :Thông báo không tìm thấy voucher;
    stop
  endif
else (Có)
endif
|Admin|
if (Chọn\nngừng sử dụng?) then (Có)
  |Hệ thống|
  if (Đã\nngừng sử dụng?) then (Có)
    :Thông báo voucher đã ngừng sử dụng;
    stop
  else (Không)
  endif
else (Không)
endif
|Hệ thống|
:Hiển thị biểu mẫu hoặc yêu cầu xác nhận\ntheo thao tác đã chọn;
|Admin|
:Nhập hoặc sửa thông tin nếu cần,
xem lại thông tin voucher;
if (Xác nhận\nthao tác?) then (Có)
else (Không)
  :Hủy thao tác;
  stop
endif

|Hệ thống|
:Kiểm tra thông tin voucher;
while (Dữ liệu\nhợp lệ?) is (Không)
  :Thông báo lỗi và yêu cầu nhập lại;
  |Admin|
  :Điều chỉnh thông tin voucher;
  :Xác nhận thông tin;
  |Hệ thống|
  :Kiểm tra lại thông tin voucher;
endwhile (Có)

:Lưu mới / sửa thông tin / ngừng sử dụng\ntheo thao tác đã chọn;

|Hệ thống|
if (Lưu thay đổi\nthành công?) then (Có)
  :Thông báo thành công;
  :Cập nhật danh sách voucher;
else (Không)
  :Thông báo thao tác thất bại;
endif
stop
@enduml
