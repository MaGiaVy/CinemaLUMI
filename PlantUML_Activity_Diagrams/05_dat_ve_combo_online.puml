@startuml 05_dat_ve_combo_online
title SƠ ĐỒ HOẠT ĐỘNG: ĐẶT VÉ VÀ MUA COMBO ONLINE (ONLINE TICKET & COMBO BOOKING)
skinparam conditionStyle insideDiamond
skinparam defaultTextAlignment center
skinparam shadowing false
skinparam monochrome true
skinparam wrapWidth 180

|Khách hàng|
|Hệ thống|
|Cổng ZaloPay Sandbox v2|
|Khách hàng|
start
:Chọn phim đang chiếu;
:Lọc suất chiếu theo ngày chiếu,\nthể loại phim và phòng chiếu;

|Hệ thống|
:Hiển thị danh sách suất chiếu phù hợp;

|Khách hàng|
:Chọn suất chiếu;

|Hệ thống|
:Hiển thị sơ đồ 50 ghế (A1-E10)\nvà trạng thái từng ghế;

|Khách hàng|
:Chọn ghế trên sơ đồ A1-E10\n(tối đa 08 ghế/giao dịch - MAX_SEATS = 8);

|Hệ thống|
:Kiểm tra trạng thái ghế và giới hạn MAX_SEATS = 8;
while (Ghế trống?) is (Không)
  :Thông báo và yêu cầu chọn ghế khác;
  |Khách hàng|
  :Chọn lại ghế;
  |Hệ thống|
  :Kiểm tra lại trạng thái ghế;
endwhile (Có)
:Chuyển ghế sang RESERVED\nđặt reservedUntil = NOW() + 10 phút;

|Khách hàng|
:Chọn loại vé cho từng ghế\n(Thường 100% hoặc Trẻ em 50%);

|Hệ thống|
if (Phim T18?) then (Có - BR-02)
  :Khóa lựa chọn vé Trẻ em (50%)\nvà bắt buộc dùng vé Thường (100%);
else (Không)
endif
:Tính giá vé (Thường 100%, Trẻ em 50%);

|Khách hàng|
if (Thêm combo?) then (Có)
  :Chọn combo và số lượng;
  |Hệ thống|
  if (Còn hàng?) then (Có)
    :Giữ tồn kho combo tạm thời 10 phút (ComboReservation)\nvà thêm combo vào đơn hàng;
  else (Không)
    :Thông báo combo không đủ tồn kho;
  endif
else (Không)
endif

|Khách hàng|
if (Dùng voucher?) then (Có)
  :Nhập hoặc chọn mã voucher;
  |Hệ thống|
  if (Hợp lệ?) then (Có)
    :Áp dụng giảm giá trên tiền vé\n(không áp dụng trên tiền combo);
  else (Không)
    :Thông báo voucher không hợp lệ\nvà không áp dụng giảm giá;
  endif
else (Không)
endif

|Hệ thống|
:Tính tổng đơn = tiền vé sau giảm giá + tiền combo;
:Hiển thị thông tin đơn hàng và số tiền cần thanh toán;

|Khách hàng|
:Chọn thanh toán trực tuyến qua ZaloPay Sandbox v2;

|Hệ thống|
:Tạo đơn hàng Payment (status = 'Pending')\nvà vé tạm (bảo vệ bởi Partial Unique Index unique_active_ticket);
:Gọi API tạo đơn ZaloPay Sandbox v2\n(app_id: 2553, ký HMAC-SHA256 bằng ZALOPAY_KEY1);

|Cổng ZaloPay Sandbox v2|
:Tiếp nhận yêu cầu tạo đơn\nvà trả về order_url;

|Khách hàng|
:Thực hiện thanh toán trên cổng ZaloPay Sandbox v2;

|Cổng ZaloPay Sandbox v2|
:Xử lý giao dịch, gửi Webhook IPN (/api/payments/zalopay/callback)\nvà điều hướng về Return URL (/api/payments/zalopay/return);

|Hệ thống|
:Xác thực chữ ký HMAC-SHA256 (ZALOPAY_KEY2)\ncủa Callback IPN & Return URL (return_code == 1);
if (Thành công?) then (Có)
  :Cập nhật Payment.status = 'Success';
  :Chuyển các vé sang Valid\n(ràng buộc chống bán trùng unique_active_ticket);
  :Chuyển các ghế sang OCCUPIED;
  :Chuyển ComboReservation sang COMPLETED\nvà tạo OrderCombo (isDelivered = false);
  :Tăng lượt dùng voucher (Coupon.usedCount + 1);
  :Sinh chữ ký HMAC-SHA256 trên mã vé\nvà hiển thị mã QR bằng <QRCodeSVG />;
  :Gửi email xác nhận kèm vé điện tử;
  |Khách hàng|
  :Nhận vé điện tử có mã QR (<QRCodeSVG />);
  stop
else (Không)
  |Hệ thống|
  :Cập nhật Payment.status = 'Failed', hủy vé tạm\nvà giải phóng ghế về EMPTY;
  :Giải phóng ComboReservation (RELEASED) hoàn tồn kho combo\nvà bảo toàn lượt dùng voucher;
  |Khách hàng|
  :Nhận thông báo giao dịch chưa hoàn tất;
  stop
endif
@enduml
