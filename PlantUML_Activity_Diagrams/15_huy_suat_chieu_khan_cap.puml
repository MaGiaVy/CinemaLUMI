@startuml 15_huy_suat_chieu_khan_cap
title SƠ ĐỒ HOẠT ĐỘNG: HỦY SUẤT CHIẾU KHẨN CẤP DO SỰ CỐ (EMERGENCY SCREENING CANCELLATION)
skinparam conditionStyle insideDiamond
skinparam defaultTextAlignment center
skinparam shadowing false
skinparam monochrome true
skinparam wrapWidth 180

|Admin|
|Hệ thống|
|Admin|
start
:Chọn quản lý suất chiếu;
:Chọn suất chiếu gặp sự cố phòng chiếu;
:Chọn hủy suất chiếu khẩn cấp\nvà nhập lý do sự cố;

|Hệ thống|
:Tìm suất chiếu và kiểm tra trạng thái;
if (Còn hiệu lực?) then (Có)
else (Không)
  :Thông báo không thể hủy suất chiếu;
  stop
endif

|Hệ thống|
:Hiển thị cảnh báo số vé và combo bị ảnh hưởng;

|Admin|
if (Xác nhận?) then (Có)
else (Không)
  :Hủy thao tác;
  stop
endif

|Hệ thống|
:Chuyển suất chiếu sang Cancelled và ngừng bán vé;
:Hủy toàn bộ vé chưa sử dụng của suất chiếu\n(vé đã Used được giữ nguyên);
:Ghi nhận công nợ Chờ hoàn tiền 100%\ncho các vé bị hủy;
:Giải phóng ghế nhưng khóa không cho đặt lại\ntrên suất chiếu này;
:Hoàn tiền và cộng lại tồn kho cho combo Chưa nhận;
:Ghi nhận nhật ký kiểm toán;
if (Thành công?) then (Có)
  :Gửi thông báo cho khách:\ncó 30 ngày để nhận hoàn tiền mặt tại rạp;
  :Hiển thị kết quả xử lý sự cố;
else (Không)
  :Hoàn tác toàn bộ thay đổi (rollback)\nvà thông báo thao tác thất bại;
endif

|Admin|
:Xem kết quả xử lý;

stop
@enduml

