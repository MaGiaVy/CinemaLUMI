@startuml class_diagram_lumicinema
title MASTER DOMAIN MODEL CLASS DIAGRAM - HỆ THỐNG RẠP CHIẾU PHIM LUMICINEMA
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam backgroundColor #FFFFFF
skinparam roundcorner 4
skinparam linetype ortho
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 12

skinparam class {
    BackgroundColor #FFFFFF
    ArrowColor #1E293B
    BorderColor #1E293B
    HeaderBackgroundColor #F1F5F9
}

skinparam package {
    BackgroundColor #FAFAFA
    BorderColor #94A3B8
    FontColor #334155
}

' =========================================================================
' 1. USER & SPECIALIZATION (PHÂN HỆ NGƯỜI DÙNG & PHÂN QUYỀN RBAC)
' =========================================================================
abstract class User {
    - id: Int
    - email: String
    - passwordHash: String
    - name: String
    - phone: String
    - role: Role
    - createdAt: DateTime
    + register(email: String, password: String, name: String, phone: String): Boolean
    + login(email: String, password: String): String
    + updateProfile(name: String, phone: String): Boolean
    + changePassword(oldPass: String, newPass: String): Boolean
}

class Customer {
    + bookTicket(screeningId: Int, seatIds: List<Int>, couponCode: String): Payment
    + selectCombo(comboId: Int, quantity: Int): Void
    + applyCoupon(code: String): Decimal
    + cancelTicket(ticketId: Int, reason: String): Boolean
    + writeReview(movieId: Int, rating: Int, comment: String): Review
}

class Staff {
    + sellTicketAtPOS(screeningId: Int, seatIds: List<Int>, method: PaymentMethod): Payment
    + sellComboAtPOS(comboId: Int, quantity: Int, method: PaymentMethod): Payment
    + checkInTicket(ticketCode: String): Boolean
    + deliverCombo(orderComboId: Int): Void
}

class Admin {
    + createMovie(movieData: Movie): Movie
    + scheduleScreening(screeningData: Screening): Screening
    + manageCombo(comboData: Combo): Combo
    + issueCoupon(couponData: Coupon): Coupon
    + viewReports(from: Date, to: Date): ReportData
}

' =========================================================================
' 2. MOVIE & SCREENING (PHÂN HỆ PHIM, SUẤT CHIẾU & GIÁ VÉ)
' =========================================================================
class Movie {
    - id: Int
    - title: String
    - slug: String
    - description: String
    - duration: Int
    - releaseDate: Date
    - endDate: Date
    - ageRating: String
    - poster: String
    - trailer: String
    - genre: String
    - rating: Decimal
    - status: MovieStatus
    - ticketPrice: Decimal
    + getActiveScreenings(): List<Screening>
    + calculateAverageRating(): Decimal
    + updateStatus(newStatus: MovieStatus): Void
}

class Screening {
    - id: Int
    - room: String
    - roomNumber: Int
    - startTime: DateTime
    - endTime: DateTime
    - date: Date
    - price: Decimal
    - status: ScreeningStatus
    + checkRoomConflict(startTime: DateTime, endTime: DateTime, roomNumber: Int): Boolean
    + generateSeats(): Void
    + cancelScreening(reason: String): Boolean
}

class Seat {
    - id: Int
    - room: String
    - row: String
    - number: Int
    - code: String
    - type: SeatType
    - status: SeatStatus
    - reservedUntil: DateTime
    + holdSeat(durationMinutes: Int): Boolean
    + releaseSeat(): Void
    + markAsOccupied(): Void
}

class Pricing {
    - id: Int
    - ticketType: String
    - label: String
    - percentage: Int
    - basePrice: Decimal
    - description: String
    + calculateFinalPrice(basePrice: Decimal, seatType: SeatType): Decimal
}

' =========================================================================
' 3. TICKETING & PAYMENT (PHÂN HỆ VÉ, THANH TOÁN & VOUCHER)
' =========================================================================
class Ticket {
    - id: Int
    - ticketType: String
    - price: Decimal
    - purchaseDate: DateTime
    - status: TicketStatus
    - cancellationReason: String
    + generateQRCode(): String
    + verifyQRCode(signature: String): Boolean
    + checkIn(): Boolean
    + cancelTicket(reason: String): Boolean
}

class Payment {
    - id: Int
    - amount: Decimal
    - paymentMethod: PaymentMethod
    - transactionCode: String
    - status: PaymentStatus
    - createdAt: DateTime
    + calculateTotal(tickets: List<Ticket>, combos: List<OrderCombo>, coupon: Coupon): Decimal
    + createPaymentUrl(gateway: PaymentMethod): String
    + processIPNCallback(data: Map<String, String>): Boolean
    + issueRefund(amount: Decimal, method: PaymentMethod): Boolean
}

class Coupon {
    - id: Int
    - code: String
    - discountType: DiscountType
    - discountValue: Decimal
    - minAmount: Decimal
    - maxUsage: Int
    - usedCount: Int
    - expiryDate: Date
    + validateCoupon(orderAmount: Decimal, movieId: Int): Boolean
    + calculateDiscount(ticketAmount: Decimal): Decimal
    + markAsUsed(): Void
}

' =========================================================================
' 4. CONCESSION & REVIEW (PHÂN HỆ BẮP NƯỚC & ĐÁNH GIÁ)
' =========================================================================
class Combo {
    - id: Int
    - name: String
    - description: String
    - price: Decimal
    - stock: Int
    - status: ComboStatus
    - image: String
    + checkStockAvailability(quantity: Int): Boolean
    + deductStock(quantity: Int): Void
    + restock(quantity: Int): Void
}

class OrderCombo {
    - id: Int
    - quantity: Int
    - price: Decimal
    - isDelivered: Boolean
    - deliveredAt: DateTime
    + markAsDelivered(): Void
    + getSubtotal(): Decimal
}

class ComboReservation {
    - id: Int
    - quantity: Int
    - status: String
    - reservedUntil: DateTime
    + checkExpiry(): Boolean
    + release(): Void
}

class Review {
    - id: Int
    - rating: Int
    - comment: String
    - createdAt: DateTime
    + createReview(userId: Int, movieId: Int, rating: Int, comment: String): Boolean
    + hideReview(): Void
}

' =========================================================================
' 5. ENUMS & TYPES (HỆ THỐNG 10 ENUMS CHUẨN ĐỒNG BỘ CSDL PRISMA)
' =========================================================================
package "Enums & Types" {
    enum Role {
        CUSTOMER
        STAFF
        ADMIN
    }

    enum MovieStatus {
        SHOWING
        UPCOMING
        ENDED
    }

    enum ScreeningStatus {
        UPCOMING
        SHOWING
        ENDED
        CANCELLED
    }

    enum SeatType {
        STANDARD
        VIP
        COUPLE
    }

    enum SeatStatus {
        EMPTY
        RESERVED
        OCCUPIED
    }

    enum TicketStatus {
        Valid
        Used
        Cancelled
    }

    enum ComboStatus {
        ACTIVE
        INACTIVE
    }

    enum PaymentMethod {
        VNPay
        Momo
        Cash
        BankCard
    }

    enum PaymentStatus {
        Pending
        Success
        Failed
        Refunded
    }

    enum DiscountType {
        Percentage
        FixedAmount
    }
}

' =========================================================================
' 6. RELATIONSHIPS (QUAN HỆ HƯỚNG ĐỐI TƯỢNG: KẾ THỪA, HỢP THÀNH, KẾT TẬP)
' =========================================================================

' Generalization (Kế thừa)
User <|-- Customer
User <|-- Staff
User <|-- Admin

' Composition (Hợp thành - Ràng buộc sinh tử / Lifecycle Coupling)
Screening "1" *-- "50" Seat : sở hữu
Payment "1" *-- "0..*" OrderCombo : bao gồm
Combo "1" *-- "0..*" ComboReservation : giữ chỗ

' Aggregation & Association (Kết tập & Hiệp hội nghiệp vụ)
Screening "0..*" o-- "1" Movie : chiếu phim
Ticket "0..*" o-- "1" Screening : thuộc suất
Ticket "1" o-- "1" Seat : chiếm chỗ
Ticket "0..*" o-- "1" User : sở hữu bởi
Ticket "0..*" o-- "1" Payment : thanh toán qua
OrderCombo "0..*" o-- "1" Combo : đặt món
Payment "0..*" o-- "0..1" Coupon : áp dụng
Review "0..*" o-- "1" Movie : bình luận cho
Review "0..*" o-- "1" User : tạo bởi
Screening "0..*" ..> "1" Pricing : tham chiếu tỷ lệ giá
Coupon "0..*" o-- "0..1" Movie : áp dụng riêng cho
Coupon "0..*" o-- "0..1" User : cấp riêng cho

' =========================================================================
' 7. BUSINESS RULE NOTES (GHI CHÚ QUY TẮC NGHIỆP VỤ BR-01 .. BR-10)
' =========================================================================
note bottom of Seat
  **BR-01: Giữ ghế tạm thời 10 phút**
  - Chống Race Condition bằng ACID Transaction
  - Tự động hoàn lại 'EMPTY' khi quá hạn reservedUntil
end note

note right of Ticket
  **BR-03 & BR-04: Soát vé & Hủy vé**
  - QR Code bảo mật kèm chữ ký HMAC-SHA256 (BR-09)
  - Soát vé chống check-in trùng lặp (Idempotent)
  - Hủy vé trước >= 2 tiếng nhận Voucher bồi hoàn COMP50 (BR-03)
  - Rạp hủy vé sự cố bồi hoàn tiền mặt 100% (BR-04)
end note

note left of Screening
  **BR-08 / BR-09: Giãn cách suất chiếu phòng**
  - [startTime, endTime + 15p buffer] không trùng
  - Đảm bảo phòng chiếu được dọn dẹp kỹ lưỡng
end note

note bottom of Payment
  **BR-08 & BR-10: Cổng thanh toán & Doanh thu**
  - Tích hợp VNPay / Momo xác thực mã checksum IPN
  - Bóc tách doanh thu thực thu và tiền hoàn vé (BR-10)
end note

@enduml
