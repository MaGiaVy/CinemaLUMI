@startuml 27_sua_combo
hide footbox
autonumber
skinparam style strictuml
skinparam monochrome true
skinparam defaultTextAlignment center
skinparam shadowing false
title SƠ ĐỒ TUẦN TỰ: CHỈNH SỬA THÔNG TIN COMBO (UC-17)

actor "Quản trị viên\n(Admin)" as A
boundary "Frontend Next.js\n(/admin/combos)" as UI
control "Next.js API\n(/api/combos)" as C
entity "Docker PostgreSQL\n(Prisma)" as DB

activate A
A -> UI: Chọn combo cần chỉnh sửa và bấm "Sửa"
activate UI
UI -> C: GET /api/combos/[id]
activate C
C -> DB: prisma.combo.findUnique({ where: { id: comboId } })
activate DB
DB --> C: Thông tin combo hoặc null
deactivate DB

alt Không tìm thấy combo
    C --> UI: 404 Not Found ("Không tìm thấy combo")
    UI --> A: Hiển thị thông báo lỗi
else Tìm thấy combo
    C --> UI: 200 OK (Dữ liệu combo hiện tại)
    deactivate C
    UI --> A: Hiển thị form chỉnh sửa với dữ liệu cũ\n(name, price, description, stock, status: ACTIVE | INACTIVE)
    deactivate UI
    
    A -> UI: Nhập thông tin chỉnh sửa và bấm "Lưu thay đổi"
    activate UI
    UI -> C: PUT /api/combos/[id]\n(kèm JWT ADMIN & dữ liệu cập nhật)
    activate C
    C -> C: Xác thực quyền hạn requireAuth(['ADMIN']) (FR-AUTH-03)
    C -> C: Kiểm tra dữ liệu hợp lệ Zod (updateComboSchema):\nname <= 100 ký tự, price > 0, stock >= 0, status IN ('ACTIVE', 'INACTIVE')
    
    alt Dữ liệu không hợp lệ
        C --> UI: 400 Bad Request (Lỗi định dạng giá / số lượng tồn)
        UI --> A: Hiển thị cảnh báo lỗi trên form
    else Dữ liệu hợp lệ
        C -> DB: prisma.combo.update({\n  where: { id: comboId },\n  data: { name, description, price, stock, imageUrl, status }\n})
        activate DB
        DB --> C: Bản ghi combo đã cập nhật
        deactivate DB
        C --> UI: 200 OK (Cập nhật combo thành công)
        UI --> A: Hiển thị Toast thông báo thành công & cập nhật bảng
    end
    deactivate C
    deactivate UI
end
deactivate A
@enduml
