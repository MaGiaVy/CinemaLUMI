@startuml 27_sua_combo
hide footbox
autonumber
skinparam style strictuml
skinparam monochrome true
skinparam defaultTextAlignment center
skinparam shadowing false
title SƠ ĐỒ TUẦN TỰ: CHỈNH SỬA THÔNG TIN COMBO

actor "Quản trị viên (Admin)" as A
boundary "Giao diện quản lý combo" as UI
control "Điều khiển combo" as C
entity "Dữ liệu hệ thống" as DB

activate A
A -> UI: Chọn combo cần chỉnh sửa và bấm "Sửa"
activate UI
UI -> C: Yêu cầu thông tin chi tiết combo theo ID
activate C
C -> DB: Tra cứu combo trong CSDL
activate DB
DB --> C: Thông tin combo hoặc null
deactivate DB

alt Không tìm thấy combo
    C --> UI: Báo 404 Not Found (Không tìm thấy combo)
    activate UI
    UI --> A: Hiển thị thông báo lỗi
    deactivate UI
else Tìm thấy combo
    C --> UI: Dữ liệu combo hiện tại
    deactivate C
    UI --> A: Hiển thị form chỉnh sửa với dữ liệu cũ
    deactivate UI
    
    A -> UI: Nhập thông tin chỉnh sửa và bấm "Lưu thay đổi"
    activate UI
    UI -> C: Gửi dữ liệu cập nhật combo
    activate C
    C -> C: Kiểm tra dữ liệu hợp lệ (Đơn giá > 0)
    
    alt Dữ liệu không hợp lệ
        C --> UI: Báo 400 Bad Request (Lỗi định dạng giá)
        activate UI
        UI --> A: Hiển thị cảnh báo lỗi trên form
        deactivate UI
    else Dữ liệu hợp lệ
        C -> DB: Cập nhật thông tin combo vào CSDL
        activate DB
        DB --> C: Bản ghi combo đã cập nhật
        deactivate DB
        C --> UI: Báo 200 OK (Cập nhật thành công)
        activate UI
        UI --> A: Hiển thị Toast thông báo thành công & cập nhật bảng
        deactivate UI
    end
    deactivate C
    deactivate UI
end
deactivate A
@enduml
