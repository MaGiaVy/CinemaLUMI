@startuml
title Sơ đồ Use Case - Báo Cáo Doanh Thu
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

actor "Admin" as Admin

rectangle "Báo cáo doanh thu" {
  usecase "Xem báo cáo doanh thu" as UC_Revenue
  usecase "Lọc theo thời gian / phim / suất chiếu" as UC_Filter
  usecase "Tổng hợp doanh thu vé và combo" as UC_Aggregate
  usecase "Xuất báo cáo CSV" as UC_ExportCSV
}

Admin --> UC_Revenue

UC_Revenue ..> UC_Aggregate : <<include>>
UC_Filter ..> UC_Revenue : <<extend>>
UC_ExportCSV ..> UC_Revenue : <<extend>>
@enduml
