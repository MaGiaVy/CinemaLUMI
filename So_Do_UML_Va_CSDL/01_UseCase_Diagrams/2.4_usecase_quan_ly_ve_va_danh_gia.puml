@startuml
title Sơ đồ Use Case - Quản Lý Vé Của Khách Hàng & Đánh Giá Phim
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

actor "Khách hàng" as Customer

rectangle "Quản lý vé của khách hàng và đánh giá" {
  usecase "Đăng nhập" as UC_Login
  usecase "Xem vé đã mua" as UC_ViewTickets
  usecase "Yêu cầu hủy vé" as UC_Cancel
  usecase "Kiểm tra điều kiện hủy\n(>= 2 giờ trước suất chiếu & chưa sử dụng)" as UC_CheckCancel
  usecase "Cấp voucher giảm giá 50%\n& giải phóng ghế" as UC_IssueVoucher
  usecase "Đánh giá phim\n(rating 1-5 sao + bình luận)" as UC_Review
}

Customer --> UC_ViewTickets
Customer --> UC_Cancel
Customer --> UC_Review

UC_ViewTickets ..> UC_Login : <<include>>
UC_Cancel ..> UC_Login : <<include>>
UC_Cancel ..> UC_CheckCancel : <<include>>
UC_Cancel ..> UC_IssueVoucher : <<include>>
UC_Review ..> UC_Login : <<include>>
@enduml
