@startuml
title Sơ đồ Use Case - Quản Lý Phim
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

actor "Admin" as Admin

rectangle "Quản lý phim" {
  usecase "Quản lý phim" as UC_Main
  usecase "Thêm phim" as UC_Add
  usecase "Sửa phim" as UC_Edit
  usecase "Ngừng chiếu phim" as UC_Stop
}

Admin --> UC_Main

UC_Add ..> UC_Main : <<extend>>
UC_Edit ..> UC_Main : <<extend>>
UC_Stop ..> UC_Main : <<extend>>
@enduml
