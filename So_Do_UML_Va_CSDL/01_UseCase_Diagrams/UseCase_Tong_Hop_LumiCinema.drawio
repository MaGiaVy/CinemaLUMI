        <UserObject label="" plantUmlData="{&#10;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam shadowing false\nskinparam actorStyle awesome\n\nactor \&quot;Khách hàng\&quot; as KH\nactor \&quot;Nhân viên\&quot; as NV\nactor \&quot;Admin\&quot; as AD\n\nrectangle \&quot;Hệ thống quản lý rạp chiếu phim\&quot; {\n\n  usecase \&quot;Đăng nhập\&quot; as DN\n  usecase \&quot;Đăng xuất\&quot; as DX\n\n  usecase \&quot;Hủy vé\&quot; as HV\n  usecase \&quot;Hủy vé online\&quot; as HVO\n  usecase \&quot;Hủy vé tại quầy\&quot; as HVQ\n  usecase \&quot;Chọn vé cần hủy\&quot; as CVH\n  usecase \&quot;Kiểm tra điều kiện hủy\&quot; as KTDK\n  usecase \&quot;Hoàn tiền / Hoàn điểm\&quot; as HT\n  usecase \&quot;Cập nhật trạng thái vé và nhả ghế\&quot; as CNV\n  usecase \&quot;Xác thực thông tin khách tại quầy\&quot; as XTQ\n  usecase \&quot;In biên lai hủy vé\&quot; as IBL\n  usecase \&quot;Gửi thông báo xác nhận hủy\&quot; as TB\n\n  usecase \&quot;Bồi hoàn\&quot; as BH\n  usecase \&quot;Xử lý sự cố\&quot; as XLSC\n  usecase \&quot;Ghi nhận sự cố\&quot; as GNSC\n  usecase \&quot;Xác định vé bị ảnh hưởng\&quot; as XDV\n  usecase \&quot;Cấp voucher bồi hoàn\&quot; as CV\n  usecase \&quot;Nhận / sử dụng voucher bồi hoàn\&quot; as NVC\n\n  usecase \&quot;Xem báo cáo doanh thu\&quot; as BCDT\n  usecase \&quot;Lọc theo thời gian / rạp / phim\&quot; as LOC\n  usecase \&quot;Tổng hợp doanh thu vé và combo\&quot; as THDT\n  usecase \&quot;Trừ vé hủy và chi phí bồi hoàn\&quot; as TRU\n  usecase \&quot;Xuất báo cáo CSV\&quot; as XUAT\n}\n\nKH --&gt; HVO\nKH --&gt; NVC\nKH --&gt; DX\n\nNV --&gt; HVQ\nNV --&gt; BH\nNV --&gt; DX\n\nAD --&gt; XLSC\nAD --&gt; CV\nAD --&gt; BCDT\nAD --&gt; DX\n\nHVO --|&gt; HV\nHVQ --|&gt; HV\n\nHV ..&gt; CVH  : &lt;&lt;include&gt;&gt;\nHV ..&gt; KTDK : &lt;&lt;include&gt;&gt;\nHV ..&gt; CNV  : &lt;&lt;include&gt;&gt;\nHV ..&gt; HT   : &lt;&lt;include&gt;&gt;\n\nHVO ..&gt; TB  : &lt;&lt;include&gt;&gt;\nHVQ ..&gt; XTQ : &lt;&lt;include&gt;&gt;\nHVQ ..&gt; IBL : &lt;&lt;include&gt;&gt;\n\nBH   ..&gt; XLSC : &lt;&lt;include&gt;&gt;\nBH   ..&gt; CV   : &lt;&lt;include&gt;&gt;\nXLSC ..&gt; GNSC : &lt;&lt;include&gt;&gt;\nXLSC ..&gt; XDV  : &lt;&lt;include&gt;&gt;\nNVC  ..&gt; CV   : &lt;&lt;include&gt;&gt;\nHT   ..&gt; CV   : &lt;&lt;extend&gt;&gt;\n\nBCDT ..&gt; LOC  : &lt;&lt;include&gt;&gt;\nBCDT ..&gt; THDT : &lt;&lt;include&gt;&gt;\nBCDT ..&gt; TRU  : &lt;&lt;include&gt;&gt;\nXUAT ..&gt; BCDT : &lt;&lt;extend&gt;&gt;\n\nHVO  ..&gt; DN : &lt;&lt;include&gt;&gt;\nHVQ  ..&gt; DN : &lt;&lt;include&gt;&gt;\nBH   ..&gt; DN : &lt;&lt;include&gt;&gt;\nXLSC ..&gt; DN : &lt;&lt;include&gt;&gt;\nCV   ..&gt; DN : &lt;&lt;include&gt;&gt;\nBCDT ..&gt; DN : &lt;&lt;include&gt;&gt;\nNVC  ..&gt; DN : &lt;&lt;include&gt;&gt;\n@enduml\n&quot;,&#10;  &quot;config&quot;: null&#10;}" id="MSqNy-C_BvCVHb57vsIq-48">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
