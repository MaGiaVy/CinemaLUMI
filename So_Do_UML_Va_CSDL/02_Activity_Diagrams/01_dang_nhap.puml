@startuml 01_dang_nhap
title SƠ ĐỒ HOẠT ĐỘNG: ĐĂNG NHẬP & PHÂN QUYỀN ĐIỀU HƯỚNG (LOGIN & RBAC ROUTING)
skinparam conditionStyle insideDiamond
skinparam defaultTextAlignment center
skinparam shadowing false
skinparam monochrome true
skinparam wrapWidth 180

|Người dùng|
|Hệ thống|
|Người dùng|
start
:Truy cập trang Đăng nhập (/login);
:Nhập Email và Mật khẩu;
:Bấm nút "Đăng nhập";

|Hệ thống|
:Kiểm tra định dạng dữ liệu đầu vào;
if (Dữ liệu hợp lệ?) then (Không:\nTrống hoặc sai email)
  :Hiển thị thông báo lỗi tại ô input;
  |Người dùng|
  :Kiểm tra và sửa lại thông tin;
  stop
else (Có)
  |Hệ thống|
  :Chuẩn hóa email (lowercase, trim)\nvà truy vấn tài khoản trong CSDL;
  if (Tài khoản tồn tại?) then (Không:\nEmail chưa đăng ký)
    :Hiển thị thông báo lỗi xác thực (401);
    |Người dùng|
    :Kiểm tra lại thông tin tài khoản;
    stop
  else (Có)
    |Hệ thống|
    :Đối chiếu mật khẩu băm (bcrypt);
    if (Mật khẩu trùng khớp?) then (Không:\nSai mật khẩu)
      :Hiển thị thông báo sai mật khẩu (401);
      |Người dùng|
      :Nhập lại mật khẩu;
      stop
    else (Có)
      |Hệ thống|
      :Khởi tạo JWT Token (id, email, role)\nvà thiết lập HttpOnly Cookie phiên 24h;
      :Hiển thị thông báo "Đăng nhập thành công!";
      if (Vai trò tài khoản?) then (ADMIN)
        :Điều hướng vào trang Quản trị (/admin);
      else if (Role == STAFF?) then (STAFF)
        :Điều hướng vào quầy Nhân viên (/staff);
      else (CUSTOMER)
        if (Có callbackUrl?) then (Có)
          :Quay lại trang đang đặt vé dở dang;
        else (Không)
          :Điều hướng về Trang chủ (/);
        endif
      endif

      |Người dùng|
      :Truy cập không gian làm việc tương ứng;
      stop
    endif
  endif
endif
@enduml
