@startuml 17_bao_cao_doanh_thu
title SƠ ĐỒ HOẠT ĐỘNG: DASHBOARD & BÁO CÁO DOANH THU TÀI CHÍNH (ADMIN DASHBOARD & REPORTS)
skinparam conditionStyle insideDiamond
skinparam defaultTextAlignment center
skinparam shadowing false
skinparam monochrome true
skinparam wrapWidth 180

|Admin|
|Hệ thống|
|Admin|
start
:Chọn chức năng Thống kê / Báo cáo\n(/admin/dashboard hoặc /admin/reports);

|Hệ thống|
:Kiểm tra xác thực và quyền Quản trị viên (ADMIN);
if (Đủ quyền Admin?) then (Không:\nHTTP 403)
  :Thông báo "Truy cập bị từ chối"\nvà chuyển về Trang chủ (/);
  |Admin|
  :Bị từ chối truy cập;
  stop
else (Có)
  |Admin|
  if (Màn hình muốn xem?) then (Dashboard\n/admin/dashboard)
    |Hệ thống|
    :Truy vấn doanh thu theo thời gian,\nTop 5 Box Office & trạng thái 5 phòng chiếu;
    :Hiển thị biểu đồ StreamgraphRevenueChart,\nbảng Top 5 Box Office & tình trạng 5 phòng;
    |Admin|
    :Theo dõi tổng quan doanh thu & vận hành;
    stop
  else (Báo cáo chi tiết\n/admin/reports)
    |Hệ thống|
    :Hiển thị giao diện Báo cáo Doanh thu\nvà thanh bộ lọc điều kiện;

    |Admin|
    :Thiết lập bộ lọc (khoảng ngày, phim, phòng chiếu);
    :Bấm nút "Xem báo cáo";

    |Hệ thống|
    :Kiểm tra tính hợp lệ của bộ lọc;
    if (Bộ lọc hợp lệ?) then (Không:\nNgày bắt đầu > kết thúc)
      :Hiển thị thông báo lỗi khoảng ngày (400);
      |Admin|
      :Điều chỉnh lại khoảng thời gian;
      stop
    else (Có)
      |Hệ thống|
      :Tổng hợp doanh thu vé thực thu (Valid/Used),\ndoanh thu bắp nước (Combo), tiền đã hoàn (BR-04)\nvà tỷ lệ lấp đầy phòng chiếu;
      if (Có dữ liệu giao dịch?) then (Không)
        :Hiển thị trạng thái trống:\n"Không tìm thấy giao dịch";
      else (Có)
        :Hiển thị các thẻ KPI tài chính\nvà bảng đối soát chi tiết từng suất chiếu;
      endif

      |Admin|
      :Xem xét, phân tích số liệu doanh thu;
      if (Thao tác tiếp theo?) then (Xuất CSV)
        |Hệ thống|
        :Xuất bảng đối soát sang tệp .csv\nvà tải xuống thiết bị Admin;
        |Admin|
        :Lưu trữ tệp báo cáo .csv;
        stop
      else if (Đổi điều kiện?) then (Lọc lại)
        |Admin|
        :Chọn lại khoảng ngày hoặc phòng chiếu;
        stop
      else (Hoàn tất)
        |Admin|
        :Rời khỏi màn hình Báo cáo;
        stop
      endif
    endif
  endif
endif
@enduml
