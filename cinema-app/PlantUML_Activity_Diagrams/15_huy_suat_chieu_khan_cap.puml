@startuml 15_huy_suat_chieu_khan_cap
title SƠ ĐỒ HOẠT ĐỘNG: HỦY SUẤT CHIẾU KHẨN CẤP DO SỰ CỐ (DELETE /api/screenings/[id])
skinparam conditionStyle insideDiamond
skinparam defaultTextAlignment center
skinparam shadowing false
skinparam monochrome true
skinparam wrapWidth 180

|Admin|
|Hệ thống|
|Admin|
start
:Chọn quản lý suất chiếu;
:Chọn suất chiếu gặp sự cố kỹ thuật / phòng chiếu;
:Chọn hủy suất chiếu khẩn cấp\n(gọi DELETE /api/screenings/[id]);

|Hệ thống|
:Tìm suất chiếu và kiểm tra trạng thái;
if (Còn hiệu lực?) then (Có)
else (Không)
  :Thông báo không thể hủy suất chiếu đã kết thúc;
  stop
endif

|Hệ thống|
:Hiển thị cảnh báo số lượng vé Valid bị ảnh hưởng;

|Admin|
if (Xác nhận?) then (Có)
else (Không)
  :Hủy thao tác;
  stop
endif

|Hệ thống|
:Soft-close suất chiếu sang trạng thái ENDED\nvà ngừng bán vé;
:Hủy toàn bộ vé đang ở trạng thái Valid sang Cancelled\n(giữ nguyên các vé đã Used);
:Giải phóng toàn bộ ghế của suất chiếu về EMPTY;
:Hoàn lại tồn kho Combo.stock cho các combo chưa nhận\n(OrderCombo.isDelivered = false);
:Ghi nhận nhật ký kiểm toán (AuditLog);
if (Thành công?) then (Có)
  :Gửi email thông báo hủy vé & hoàn tiền mặt\n(sendTicketCancelledCashRefund) cho từng khách bị ảnh hưởng;
  :Hiển thị kết quả xử lý sự cố và danh sách vé đã hủy;
else (Không)
  :Hoàn tác toàn bộ thay đổi (Rollback Transaction)\nvà thông báo thao tác thất bại;
endif

|Admin|
:Xem kết quả xử lý sự cố;

stop
@enduml
