@startuml
title Sơ đồ Use Case - Bán Vé & Soát Vé Tại Quầy (POS)
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

actor "Nhân viên" as Staff

rectangle "Hệ thống bán vé & soát vé xem phim tại quầy" {
  usecase "Bán vé xem phim tại quầy" as UC_Sell
  usecase "Chọn suất chiếu" as UC_Showtime
  usecase "Chọn ghế" as UC_Seat
  usecase "Thu tiền & in vé" as UC_PayPrint
  usecase "Tìm/gắn khách theo SĐT - Email" as UC_FindCustomer
  usecase "Bán combo kèm vé" as UC_Combo
  usecase "Áp dụng voucher" as UC_Voucher

  usecase "Soát vé xem phim" as UC_Checkin
  usecase "Kiểm tra vé hợp lệ" as UC_Validate
  usecase "Cho phép vào rạp" as UC_AllowEntry
  usecase "Giao combo\n(chuyển trạng thái sang đã nhận)" as UC_DeliverCombo
}

Staff --> UC_Sell
Staff --> UC_Checkin

UC_Sell ..> UC_Showtime : <<include>>
UC_Sell ..> UC_Seat : <<include>>
UC_Sell ..> UC_PayPrint : <<include>>
UC_FindCustomer ..> UC_Sell : <<extend>>
UC_Combo ..> UC_Sell : <<extend>>
UC_Voucher ..> UC_Sell : <<extend>>

UC_Checkin ..> UC_Validate : <<include>>
UC_Checkin ..> UC_AllowEntry : <<include>>
UC_DeliverCombo ..> UC_Checkin : <<extend>>
@enduml
