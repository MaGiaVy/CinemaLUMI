@startuml
title Sơ đồ Use Case - Quản Lý Combo
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

actor "Admin" as Admin

rectangle "Quản lý combo" {
  usecase "Quản lý combo" as UC_Main
  usecase "Thêm combo" as UC_Add
  usecase "Sửa combo" as UC_Edit
  usecase "Ngừng bán combo" as UC_Stop
  usecase "Cập nhật tồn kho" as UC_Stock
}

Admin --> UC_Main

UC_Add ..> UC_Main : <<extend>>
UC_Edit ..> UC_Main : <<extend>>
UC_Stop ..> UC_Main : <<extend>>
UC_Stock ..> UC_Main : <<extend>>
@enduml
