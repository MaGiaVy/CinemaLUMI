@startuml
title Sơ đồ Use Case - Quản Lý Voucher
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

actor "Admin" as Admin

rectangle "Quản lý voucher" {
  usecase "Quản lý voucher" as UC_Main
  usecase "Thêm voucher" as UC_Add
  usecase "Sửa voucher" as UC_Edit
  usecase "Ngừng sử dụng voucher" as UC_Disable
}

Admin --> UC_Main

UC_Add ..> UC_Main : <<extend>>
UC_Edit ..> UC_Main : <<extend>>
UC_Disable ..> UC_Main : <<extend>>
@enduml
